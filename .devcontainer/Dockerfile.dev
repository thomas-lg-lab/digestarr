ARG PYTHON_VERSION=3.15-slim@sha256:08a4c22c92b79ec821a7ad49768480039ee5b7accac3955228e75366e30abc8e
FROM python:${PYTHON_VERSION}

# Metadata labels
LABEL org.opencontainers.image.title="Digestarr (Dev)"
LABEL org.opencontainers.image.description="Development container for Digestarr — includes dev dependencies, linting, and test tooling"
LABEL org.opencontainers.image.authors="thomas-lg"
LABEL org.opencontainers.image.url="https://github.com/thomas-lg-lab/digestarr"
LABEL org.opencontainers.image.source="https://github.com/thomas-lg-lab/digestarr"
LABEL org.opencontainers.image.documentation="https://github.com/thomas-lg-lab/digestarr/blob/main/CONTRIBUTING.md"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-dev.txt
